node_modules/
pm2-agent/node_modules/
pm2-agent/data/
docker-agent/node_modules/
docker-agent/data/

# Live data lives in the NAS volume, not in the repo.
# The committed data/services.json is a seed bundled into the Docker image.
# Keep it blank rather than ignoring it: the Dockerfile COPYs it, so the
# image build fails if it is missing from the checkout.

# Secrets and runtime state — never commit.
data/auth.json
data/vapid.json
data/push-subscriptions.json
data/sessions/
data/*.tmp
data/services.json.corrupt-*

# Local env overrides (Watchtower token, etc.) — see .env.example.
.env

.DS_Store
*.log

# Local dev-server launch config (machine-specific paths).
.claude/launch.json
